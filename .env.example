# Зразок файлу .env для бази даних і CRM. Скопіюйте його в .env (у корені репозиторію)
# і впишіть свої значення. Файл .env НІКОЛИ не потрапляє в репозиторій.
# Тут — лише назви змінних без справжніх значень.

# Адреса бази PostgreSQL: postgres://КОРИСТУВАЧ:ПАРОЛЬ@АДРЕСА:5432/НАЗВА_БАЗИ
# Своя на кожному середовищі (локально, тестовий сервер, основний сервер).
DATABASE_URL=

# Середовище: development (локально), test (тестовий сервер), production (основний сервер).
# На production команда db:seed відмовляється працювати, а db:migrate спершу робить резервну копію.
APP_ENV=development

# Перший адміністратор — для команди `pnpm db:create-admin`.
# Пароль вписуйте лише у свій .env і ВИДАЛІТЬ його звідти одразу після створення адміністратора.
ADMIN_LOGIN=
ADMIN_NAME=
ADMIN_PASSWORD=

# Резервні копії (`pnpm db:backup`): папка поза репозиторієм. Порожньо — ~/yaremiya-backups.
BACKUP_DIR=
# Шлях до pg_dump, якщо його немає в PATH (на Mac з Postgres.app:
# /Applications/Postgres.app/Contents/Versions/17/bin/pg_dump). Порожньо — просто pg_dump.
PG_DUMP=

# Лише для перевірки в режимі розробки (CRM): штучна затримка даних дашборду в мілісекундах,
# щоб побачити скелетони. 0 або порожньо — без затримки. На робочому сервері не діє.
DEMO_DELAY_MS=0
