{
  "name": "yaremiya",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "preview": "pnpm --filter site preview",
    "dev:crm": "pnpm --filter crm dev",
    "build:crm": "pnpm --filter crm build",
    "db:generate": "pnpm --filter @yaremiya/shared db:generate",
    "db:migrate": "pnpm --filter @yaremiya/shared db:migrate",
    "db:seed": "pnpm --filter @yaremiya/shared db:seed",
    "db:create-admin": "pnpm --filter @yaremiya/shared db:create-admin",
    "db:backup": "pnpm --filter @yaremiya/shared db:backup",
    "db:import-plants": "pnpm --filter @yaremiya/shared db:import-plants",
    "site:rebuild": "pnpm --filter site build",
    "preview:stop": "pnpm --filter site exec astro preview stop"
  },
  "packageManager": "pnpm@11.4.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0",
      "onFail": "download"
    }
  },
  "devDependencies": {}
}
