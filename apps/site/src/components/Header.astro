---
import Icon from './Icon.astro';
import { business, routes } from '../config/site';

const nav = [
  { label: 'Каталог', href: routes.catalog },
  { label: 'Про нас', href: '#about' },
  { label: 'Сезонний календар', href: '#season' },
  { label: 'Як замовити', href: '#order' },
  { label: 'Контакти', href: '#contacts' },
];
---

<header class="header on-dark">
  <a class="header__logo" href={routes.home} aria-label="ЯРЕМІЯ — простір рослин, на головну">
    <img src="/logo/yaremiia-logo-web-on-dark.svg" alt="ЯРЕМІЯ — простір рослин" height="46" width="212" />
  </a>

  <nav class="header__nav" aria-label="Головне меню">
    <ul id="main-menu" class="header__menu">
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>

  <div class="header__actions">
    <a class="round-btn" href={routes.favorites} aria-label="Вподобані">
      <Icon name="heart" size={20} />
      <span class="badge" data-fav-count aria-live="polite">0</span>
    </a>
    <a class="round-btn" href={routes.cart} aria-label="Кошик">
      <Icon name="shopping-bag" size={20} />
      <span class="badge" data-cart-count>0</span>
    </a>
    <a class="phone-btn" href={`tel:${business.phones.manager.tel}`}>
      <Icon name="phone" size={18} />
      <span class="phone-btn__text">{business.phones.manager.display}</span>
    </a>
    <button
      class="round-btn burger"
      type="button"
      aria-controls="main-menu"
      aria-expanded="false"
      aria-label="Відкрити меню"
      data-burger
    >
      <span class="burger__open"><Icon name="menu" size={22} /></span>
      <span class="burger__close"><Icon name="x" size={22} /></span>
    </button>
  </div>
</header>

<style>
  /* Шапка лежить поверх фото головного екрана */
  .header {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 40px 64px 0;
    max-width: 1440px;
    margin: 0 auto;
  }
  .header__logo { flex: none; margin-right: auto; }
  .header__logo img { height: 46px; width: auto; }

  .header__menu {
    display: flex;
    gap: 26px;
  }
  .header__menu a {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink-on-forest);
    white-space: nowrap;
    padding: 6px 0;
    border-bottom: 1.5px solid transparent;
    transition: border-color .2s, color .2s;
  }
  .header__menu a:hover { border-color: var(--color-leaf); }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: 6px;
  }

  .round-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px; height: 48px;
    border-radius: 50%;
    color: var(--color-ink-on-forest);
    background: rgba(240, 243, 238, 0.12);
    box-shadow: inset 0 0 0 1px rgba(240, 243, 238, 0.3);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: background-color .2s;
  }
  .round-btn:hover { background: rgba(240, 243, 238, 0.22); }

  .badge {
    position: absolute;
    top: -4px; right: -4px;
    min-width: 20px; height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--color-leaf);
    color: var(--color-forest);
    font-size: 11px;
    line-height: 20px;
    font-weight: 700;
    text-align: center;
  }

  .phone-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 20px 0 16px;
    border-radius: 999px;
    background: var(--color-leaf);
    color: var(--color-forest);
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
    transition: background-color .2s;
  }
  .phone-btn:hover { background: #abcd8c; }

  .burger { display: none; }
  .burger__close { display: none; }
  .burger[aria-expanded='true'] .burger__open { display: none; }
  .burger[aria-expanded='true'] .burger__close { display: block; }

  @media (max-width: 1180px) {
    .header { padding: 32px 40px 0; }
    .header__menu { gap: 18px; }
    .phone-btn__text { display: none; }
    .phone-btn { width: 48px; padding: 0; justify-content: center; }
  }

  /* Середні екрани (планшет): меню переноситься другим рядком під логотип */
  @media (min-width: 860px) and (max-width: 1023px) {
    .header { flex-wrap: wrap; row-gap: 14px; }
    .header__nav { order: 3; flex-basis: 100%; }
    .header__menu { justify-content: center; gap: 24px; }
  }

  /* Вузькі екрани: меню ховається за бургер */
  @media (max-width: 859px) {
    .header { padding: 24px 24px 0; gap: 12px; }
    .header__logo img { height: 38px; }
    .burger { display: grid; }
    .header__actions { gap: 8px; margin-left: 0; }
    .header__nav {
      position: absolute;
      top: calc(100% + 12px);
      left: 16px; right: 16px;
      display: none;
    }
    .header__nav.is-open { display: block; }
    .header__menu {
      flex-direction: column;
      gap: 0;
      padding: 8px;
      border-radius: 20px;
      background: rgba(20, 28, 22, 0.92);
      box-shadow: inset 0 0 0 1px rgba(240, 243, 238, 0.14), 0 16px 40px rgba(0, 0, 0, 0.3);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
    .header__menu a {
      display: block;
      padding: 14px 16px;
      border: 0;
      border-radius: 12px;
      font-size: 17px;
    }
    .header__menu a:hover { background: rgba(240, 243, 238, 0.08); }
  }

  @media (max-width: 420px) {
    .header { padding: 20px 16px 0; gap: 8px; }
    .header__logo img { height: 32px; }
    .round-btn, .phone-btn { width: 44px; height: 44px; }
    .header__actions { gap: 6px; }
  }
  @media (max-width: 374px) {
    .header__logo img { height: 28px; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const nav = document.querySelector<HTMLElement>('.header__nav');
  if (burger && nav) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрити меню' : 'Відкрити меню');
      nav.classList.toggle('is-open', open);
    };
    burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });
  }
</script>
